{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #brand-marquee-{{ section.id }} .brand-marquee__text {
    font-size: {{ section.settings.font_size }}vw;
  }
{%- endstyle -%}

<div
  id="brand-marquee-{{ section.id }}"
  class="brand-marquee color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding"
>
  <div class="brand-marquee__inner">
    <span class="brand-marquee__text">{{ section.settings.text | escape }}</span>
  </div>
</div>

<script src="{{ 'ninetynine-marquee.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Brand marquee",
  "tag": "section",
  "class": "section section--brand-marquee",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "NINETYNINE©2026"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 8,
      "max": 24,
      "step": 1,
      "unit": "vw",
      "label": "Font size",
      "default": 16
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Brand marquee"
    }
  ]
}
{% endschema %}
